# secrets.toml.example — Modelo de referência (pode commitar este arquivo)
# Copie este arquivo para .streamlit/secrets.toml e preencha com seus valores reais.

# Token HuggingFace (para modelos privados ou evitar rate limiting):
# [huggingface]
# token = "hf_SeuTokenAqui"

# Chave OpenAI (se quiser usar a API no futuro):
# [openai]
# api_key = "sk-SeuTokenAqui"
